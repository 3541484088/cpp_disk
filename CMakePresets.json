{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-debug-x64",
      "displayName": "Windows Debug x64",
      "description": "MSVC 2022 + Debug + x64",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "E:/environment/bin",
        "XDISK_ENV_ROOT":       "E:/environment",
        "XDISK_QT_DIR":         "D:/Qt/6.8.3/msvc2022_64",
        "XDISK_LIBEVENT_DIR":   "E:/environment/libevent",
        "XDISK_OPENSSL_DIR":    "E:/environment/openssl",
        "XDISK_PROTOBUF_DIR":   "E:/environment/protobuf-3.21.12/install",
        "XDISK_MYSQL_DIR":      "E:/environment/mysql",
        "CMAKE_PREFIX_PATH":    "D:/Qt/6.8.3/msvc2022_64"
      }
    },
    {
      "name": "windows-release-x64",
      "displayName": "Windows Release x64",
      "inherits": "windows-debug-x64",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {}
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug (Ubuntu 22.04/24.04)",
      "description": "GCC + Debug + x64. 先运行 scripts/ubuntu_install_deps.sh 安装依赖",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux_debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":      "Debug",
        "XDISK_ENV_ROOT":        "/opt/xdisk_env",
        "XDISK_LIBEVENT_DIR":    "/usr",
        "XDISK_OPENSSL_DIR":     "/usr",
        "XDISK_PROTOBUF_DIR":    "/opt/xdisk_env/protobuf",
        "XDISK_MYSQL_DIR":       "/usr",
        "XDISK_QT_DIR":          "/usr",
        "CMAKE_PREFIX_PATH":     "/opt/xdisk_env/protobuf"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "inherits": "linux-debug",
      "binaryDir": "${sourceDir}/build/linux_release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "win-debug-build",   "configurePreset": "windows-debug-x64" },
    { "name": "win-release-build", "configurePreset": "windows-release-x64" },
    { "name": "linux-debug-build",  "configurePreset": "linux-debug" },
    { "name": "linux-release-build","configurePreset": "linux-release" }
  ]
}
